{
  "name": "polifroni-obras",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "App de procesos · 🪟 Obras (Polifroni) — mismo sistema de diseño que La Batea",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.api.json --noEmit",
    "test:portero": "esbuild tests/portero-referer.test.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=node_modules/.cache/portero.test.mjs && node node_modules/.cache/portero.test.mjs",
    "test:guard": "esbuild tests/guard-sesion.test.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=node_modules/.cache/guard.test.mjs && node node_modules/.cache/guard.test.mjs",
    "test:whitelist": "esbuild tests/lista-blanca.test.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=node_modules/.cache/whitelist.test.mjs && node node_modules/.cache/whitelist.test.mjs",
    "test:mfa": "esbuild tests/mfa.test.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=node_modules/.cache/mfa.test.mjs && node node_modules/.cache/mfa.test.mjs",
    "test:produccion": "esbuild tests/produccion.test.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=node_modules/.cache/produccion.test.mjs && node node_modules/.cache/produccion.test.mjs",
    "test:agenda": "esbuild tests/agenda.test.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=node_modules/.cache/agenda.test.mjs && node node_modules/.cache/agenda.test.mjs",
    "test:presupuesto": "esbuild tests/presupuesto.test.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=node_modules/.cache/presupuesto.test.mjs && node node_modules/.cache/presupuesto.test.mjs",
    "test:confirmar": "esbuild tests/confirmar.test.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=node_modules/.cache/confirmar.test.mjs && node node_modules/.cache/confirmar.test.mjs",
    "test:equipos": "esbuild tests/equipos.test.ts --bundle --platform=node --format=esm --packages=external --tsconfig=tsconfig.json --outfile=node_modules/.cache/equipos.test.mjs && node node_modules/.cache/equipos.test.mjs",
    "test:seguridad": "npm run test:portero && npm run test:guard && npm run test:whitelist && npm run test:mfa && npm run test:equipos"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "@react-pdf/renderer": "^4.9.0",
    "exceljs": "^4.4.0",
    "jsonwebtoken": "^9.0.3",
    "monday-sdk-js": "^1.0.0-beta",
    "otplib": "^13.5.0",
    "pdfjs-dist": "^5.6.205",
    "pg": "^8.23.0",
    "qrcode": "^1.5.4",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^26.6.0",
    "@types/pg": "^8.23.1",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
