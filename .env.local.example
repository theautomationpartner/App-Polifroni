# Copiá este archivo como `.env.local` y completá los valores. `.env.local` NO se sube a git.
#
# ── DESARROLLO (npm run dev) ────────────────────────────────────────────────────
# Sólo acá existe VITE_MONDAY_TOKEN: es el token que usa el proxy de Vite contra api.monday.com.
# En producción NO se usa esta variable (ver abajo).
VITE_MONDAY_TOKEN=

# Opcional, sólo local: fuerza los roles con que entra la app, uno o varios separados por coma
# (admin | produccion | admin,produccion | ninguno). Sin ella, salen de los teams de Monday del dueño
# del token: cada team suma su rol (Admin → admin, Produccion → produccion).
VITE_DEV_ROL=

# Webhook de Make del envío al TALLER (es el único escenario que la app sigue disparando). Sin
# prefijo VITE_ a propósito: lo lee el proxy de Vite, así la URL no entra en el navegador.
MAKE_WEBHOOK_ENVIAR_OP_TALLER=
# Numeración de las OP: la base Postgres (Neon), la misma que producción (ver db/numeracion.sql).
DATABASE_URL=
# Clave de la API de Claude (console.anthropic.com → API Keys). Lee la orden de HETMO de las OP de
# PVC (vidrios y observaciones). Sin VITE_: la usa sólo el servidor, nunca el navegador.
ANTHROPIC_API_KEY=
# Envío de la OP al cliente/constructor por WhatsApp, desde la app (ya no pasa por Make):
#   WHATSAPP_360_API_KEY  la API key de 360messenger (panel de 360messenger → API)
#   GOOGLE_*              OAuth de polifroniaberturas@gmail.com, dueña de la carpeta de Drive donde se
#                         sube el PDF que se manda. El refresh token con el permiso
#                         https://www.googleapis.com/auth/drive
#   GOOGLE_DRIVE_FOLDER_ID (opcional) por defecto "Sistema / imagenes", la del escenario
WHATSAPP_360_API_KEY=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
GOOGLE_DRIVE_FOLDER_ID=
# El formulario de confirmación de la OP (escenario de Make): el enlace que recibe quien confirma.
# OBLIGATORIA para enviar una OP. No va en el código: el repositorio es público.
CONFIRMAR_OP_URL=

# ── PRODUCCIÓN (Vercel) ─────────────────────────────────────────────────────────
# En el panel de Vercel (Settings → Environment Variables) van estas, ninguna con VITE_:
#
#   MONDAY_TOKEN            el token de Monday de Polifroni
#   ANTHROPIC_API_KEY       la clave de la API de Claude (lectura de la orden de HETMO)
#   WHATSAPP_360_API_KEY    la API key de 360messenger (WhatsApp de OP, presupuestos y Agenda)
#   GOOGLE_CLIENT_ID / GOOGLE_CLIENT_SECRET / GOOGLE_REFRESH_TOKEN   Drive (el PDF que se envía)
#   GOOGLE_DRIVE_FOLDER_ID  (opcional) la carpeta de Drive
#   CONFIRMAR_OP_URL        el formulario de confirmación de la OP (obligatoria para enviar una OP)
#   MAKE_WEBHOOK_ENVIAR_OP_TALLER     el envío al taller
#
# Ya NO se usan (se pueden borrar): MAKE_TOKEN, MAKE_WEBHOOK_LEER_DOC / LEER_DOC,
# MAKE_WEBHOOK_LEER_OBSERVACIONES / LEER_OBSERVACIONES, MAKE_WEBHOOK_ENVIAR_OP / ENVIAR_OP,
# MAKE_WEBHOOK_AGENDA_* y APP_URL.
#
# Las leen las Serverless Functions de `api/`, que son las que hablan con Monday y con Make. Una
# variable con prefijo VITE_ se compila DENTRO del JavaScript que descarga el navegador: cargar el
# token como VITE_MONDAY_TOKEN en Vercel sería publicarlo.

# ── SEGURIDAD (las tres capas, igual que La Batea) ──────────────────────────────
# Sólo en Vercel (Settings → Environment Variables), ninguna con VITE_. En `npm run dev` las capas
# no existen: la app entra directo con VITE_MONDAY_TOKEN.
#
#   MONDAY_CLIENT_SECRET   Client Secret de la app de Monday (Developer Center → Basic Information).
#                          Con él se verifica la firma del session token.
#   MONDAY_SIGNING_SECRET  Signing Secret de la misma app. Respaldo: se prueba si el anterior no cierra.
#   MONDAY_ACCOUNT_ID      30446835 (Polifronipuertas). Ata la app a esta cuenta de Monday.
#   WHITELIST_BOARD_ID     18433213451 (opcional: es el valor por defecto). Tablero privado de la lista.
#   APP_ID                 (opcional) id con el que se busca ESTA app en la columna "ID APP" de la
#                          lista. Sin él se usa el app_id firmado dentro del session token.
#   DATABASE_URL           Postgres (Neon, desde Vercel → Storage), la cadena CON pooler. Guarda el
#                          segundo factor. Antes de usarla, correr db/mfa.sql una vez.
#   MFA_ENCRYPTION_KEY     32 bytes en base64 o hex. Cifra los secretos de Google Authenticator.
#                          Generarla con: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
#   MFA_REQUERIDO          1 para exigir el código de 6 dígitos. Sin él, la capa 3 queda apagada.
#   MFA_EMISOR             (opcional) nombre en la app del teléfono. Por defecto "Polifroni".

