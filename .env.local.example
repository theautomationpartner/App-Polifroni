# Copiá este archivo como `.env.local` y completá los valores. `.env.local` NO se sube a git.
#
# ── DESARROLLO (npm run dev) ────────────────────────────────────────────────────
# Sólo acá existe VITE_MONDAY_TOKEN: es el token que usa el proxy de Vite contra api.monday.com.
# En producción NO se usa esta variable (ver abajo).
VITE_MONDAY_TOKEN=

# Webhooks de Make. Sin prefijo VITE_ a propósito: los lee el proxy de Vite, así la URL del
# escenario no entra en el código que corre en el navegador.
MAKE_WEBHOOK_LEER_DOC=https://hook.us1.make.com/TU-WEBHOOK
MAKE_WEBHOOK_ENVIAR_OP=https://hook.us1.make.com/TU-WEBHOOK
MAKE_WEBHOOK_ENVIAR_OP_TALLER=
# Token de la API de Make: lee y actualiza la numeración de las OP (data store 92748).
MAKE_TOKEN=

# ── PRODUCCIÓN (Vercel) ─────────────────────────────────────────────────────────
# En el panel de Vercel (Settings → Environment Variables) van estas CUATRO, ninguna con VITE_:
#
#   MONDAY_TOKEN            el token de Monday de Polifroni
#   MAKE_WEBHOOK_LEER_DOC   mismo valor que arriba
#   MAKE_WEBHOOK_ENVIAR_OP  mismo valor que arriba
#   MAKE_WEBHOOK_ENVIAR_OP_TALLER     pendiente
#
# Las leen las Serverless Functions de `api/`, que son las que hablan con Monday y con Make. Una
# variable con prefijo VITE_ se compila DENTRO del JavaScript que descarga el navegador: cargar el
# token como VITE_MONDAY_TOKEN en Vercel sería publicarlo.
