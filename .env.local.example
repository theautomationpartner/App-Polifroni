# ── Monday ──────────────────────────────────────────────────────────────────────
# Token personal. En local viaja por el proxy de Vite (`/monday-api`), nunca al bundle de producción.
VITE_MONDAY_TOKEN=

# ── Make (webhooks ya desarrollados) ────────────────────────────────────────────
# Sin prefijo VITE_: los lee el proxy de Vite, así la URL del hook no queda en el bundle.
MAKE_WEBHOOK_LEER_DOC=https://hook.us1.make.com/TU-WEBHOOK
MAKE_WEBHOOK_ENVIAR_OP=https://hook.us1.make.com/TU-WEBHOOK
# Envío de la OP al taller: pendiente de que nos pasen la URL del escenario.
MAKE_WEBHOOK_TALLER=
