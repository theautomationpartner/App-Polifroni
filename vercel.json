{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "frame-ancestors https://*.monday.com https://*.monday.app;"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains; preload"
        }
      ]
    }
  ],
  "functions": {
    "api/hetmo.ts": {
      "maxDuration": 300,
      "includeFiles": "prompts/**"
    },
    "api/whatsapp.ts": {
      "maxDuration": 300
    },
    "api/whatsapp-texto.ts": {
      "maxDuration": 120
    }
  },
  "rewrites": [
    {
      "source": "/c/:codigo",
      "destination": "/api/confirmar?codigo=:codigo"
    },
    {
      "source": "/confirmar",
      "destination": "/api/confirmar"
    },
    {
      "source": "/((?!api/).*)",
      "destination": "/index.html"
    }
  ]
}
